{% doc %}Navigation from Shopify product types and vendors.{% enddoc %}
<div class="vn-group"><details><summary class="vn-trigger">{{ 'general.wines' | t }} ⌄</summary><div class="vn-dropdown"><span class="vn-caption">{{ 'general.explore' | t }}</span><div class="vn-options">{% for type in shop.types limit: 6 %}{% if type != blank %}<a href="{{ type | url_for_type }}">{{ type | escape }} ↗</a>{% endif %}{% endfor %}</div><a class="vn-view-all" href="{{ routes.all_products_collection_url }}">{{ 'general.all_wines' | t }} →</a></div></details></div>
<a href="{{ routes.root_url }}#paises">{{ 'general.origins' | t }}</a><a href="{{ routes.root_url }}#uvas">{{ 'general.grapes' | t }}</a>
<div class="vn-group"><details><summary class="vn-trigger">{{ 'general.producers' | t }} ⌄</summary><div class="vn-dropdown"><span class="vn-caption">{{ 'general.explore' | t }}</span><div class="vn-options">{% for vendor in shop.vendors limit: 6 %}<a href="{{ vendor | url_for_vendor }}">{{ vendor | escape }} ↗</a>{% endfor %}</div><a class="vn-view-all" href="{{ routes.root_url }}#bodegas">{{ 'general.producers' | t }} →</a></div></details></div>
