{% doc %}
@param {collection} collection - Product source
@param {string} title - Heading
@param {string} eyebrow - Eyebrow
@param {number} limit - Product limit
@param {boolean} [newest] - Show most recently created products first
{% enddoc %}
{% assign products = collection.products %}{% if newest %}{% assign products = products | sort: 'created_at' | reverse %}{% endif %}{% if products.size > 0 %}
<section class="wc-section"><div class="wc-heading"><div><p class="ve-kicker">{{ eyebrow | escape }}</p><h2>{{ title | escape }}</h2></div><div class="wc-controls"><a href="{{ collection.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }}{% render 'icon', name: 'arrow' %}</a><button type="button" hidden data-carousel-step="-1" aria-label="{{ 'general.previous' | t }}">‹</button><button type="button" hidden data-carousel-step="1" aria-label="{{ 'general.next' | t }}">›</button></div></div><div class="wc-viewport" tabindex="0" aria-label="{{ title | escape }}"><div class="wc-track"><div class="wc-group">{% for product in products limit: limit %}{% render 'product-card', product: product %}{% else %}<p>{{ 'product.empty' | t }}</p>{% endfor %}</div></div></div></section>
{% endif %}
