{% doc %}
@param {collection} collection - Collection to filter
{% enddoc %}
<dialog class="sf-filters" data-filter-dialog aria-label="{{ 'catalog.filter' | t }}"><form method="get" action="{{ collection.url }}"><div class="sf-filter-title"><h2>{{ 'catalog.refine' | t }}</h2><button type="button" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div><input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
{% for filter in collection.filters %}<fieldset><legend>{{ filter.label | escape }}</legend>{% case filter.type %}{% when 'list', 'boolean' %}{% for value in filter.values %}<label class="sf-filter-check"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<div class="sf-price-filter"><label>{{ 'catalog.min' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>{{ 'catalog.max' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" step="0.01" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label></div>{% endcase %}</fieldset>{% endfor %}<a class="sf-clear" href="{{ collection.url }}">{{ 'catalog.clear' | t }}</a><button class="sf-filter-apply sf-button" type="submit">{{ 'catalog.apply' | t }}</button></form></dialog>
