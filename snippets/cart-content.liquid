{% doc %}Server-rendered Shopify cart for page and drawer.{% enddoc %}
{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" class="sf-shopify-cart"><div class="sf-cart-items">{% for item in cart.items %}<div class="sf-cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.product.title }}</a>{% endif %}<div class="sf-cart-line-info"><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title | escape }}</small>{% endunless %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<small>{{ property.first | escape }}: {{ property.last | escape }}</small>{% endif %}{% endfor %}{% if item.selling_plan_allocation %}<small>{{ item.selling_plan_allocation.selling_plan.name | escape }}</small>{% endif %}<span>{{ item.final_line_price | money }}</span>{% for discount in item.line_level_discount_allocations %}<small>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</small>{% endfor %}<label>{{ 'product.quantity' | t }}<input aria-label="{{ 'product.quantity' | t }} — {{ item.product.title | escape }}" type="number" min="0" name="updates[]" value="{{ item.quantity }}"></label><a class="sf-remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div></div>{% endfor %}</div><div class="sf-cart-bottom">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<div><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><p>{{ 'cart.delivery' | t }}</p><button class="sf-cart-update" type="submit" name="update">{{ 'cart.update' | t }}</button><button class="sf-button" type="submit" name="checkout">{{ 'cart.checkout' | t }}{% render 'icon', name: 'arrow' %}</button></div></form>{% else %}<div class="sf-empty-cart">{% render 'icon', name: 'bag' %}<h3>{{ 'cart.empty' | t }}</h3><p>{{ 'cart.empty_intro' | t }}</p><a class="sf-button" href="{{ routes.all_products_collection_url }}">{{ 'general.explore_wines' | t }}</a></div>{% endif %}
