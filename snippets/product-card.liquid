{% assign p = product %}<article class="wine-card"><a href="{{ p.url }}" class="wine-photo">{% if p.featured_image %}{{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: p.title }}{% else %}<span>Fotografia em breve</span>{% endif %}</a><div class="wine-info"><p class="kicker">{{ p.vendor | escape }}{% if p.metafields.custom.country.value %} · {{ p.metafields.custom.country.value | escape }}{% endif %}</p><h3><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>{% if p.available %}<p class="wine-price">{{ p.price | money }}{% if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money }}</s>{% endif %}</p>{% else %}<p>Indisponível</p>{% endif %}<a class="card-link" href="{{ p.url }}">Conheça este vinho <span>↗</span></a></div></article>