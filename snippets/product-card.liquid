{% assign p = product %}
<article class="wine-card">
<a href="{{ p.url }}" class="wine-photo">{% if p.featured_image %}{{ p.featured_image | image_url: width: 650 | image_tag: loading: 'lazy', alt: p.title }}{% else %}<span>Fotografia em breve</span>{% endif %}{% assign country = p.metafields.custom.country.value %}{% if country != blank %}<span class="wine-origin-badge" aria-label="Origem: {{ country | escape }}">{% case country %}{% when 'Chile' %}🇨🇱{% when 'Argentina' %}🇦🇷{% when 'Brasil' %}🇧🇷{% when 'Portugal' %}🇵🇹{% when 'França' %}🇫🇷{% when 'Itália' %}🇮🇹{% when 'Espanha' %}🇪🇸{% else %}{{ country | escape }}{% endcase %}</span>{% endif %}</a>
<div class="wine-info"><p class="wine-region">{% if p.metafields.custom.region.value != blank %}{{ p.metafields.custom.region.value | escape }} · {% endif %}{{ country | default: p.type | escape }}</p><h3><a href="{{ p.url }}">{{ p.title | escape }}</a></h3><p class="wine-maker">{{ p.vendor | escape }}</p>{% if p.metafields.custom.grape.value != blank %}<p class="wine-grape">{{ p.metafields.custom.grape.value | escape }}</p>{% endif %}
{% if p.available %}<p class="wine-price-label">Preço</p><p class="wine-price">{{ p.price | money }}{% if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money }}</s>{% endif %}</p>{% form 'product', p, class: 'wine-card-form' %}<input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><button type="submit" class="wine-add">♧ &nbsp; Adicionar ao carrinho</button>{% endform %}{% else %}<p class="wine-unavailable">Indisponível</p><a class="wine-add" href="{{ p.url }}">Conhecer o vinho</a>{% endif %}</div></article>