<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="{{ settings.wine_color }}"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>{{ content_for_header }}{{ 'videira.css' | asset_url | stylesheet_tag }}{{ 'videira-fidelidade.css' | asset_url | stylesheet_tag }}<script src="{{ 'videira.js' | asset_url }}" defer></script><script src="{{ 'videira-fidelidade.js' | asset_url }}" defer></script></head><body class="videira template-{{ request.page_type }}" style="--wine:{{ settings.wine_color }};--gold:{{ settings.gold_color }};--paper:{{ settings.paper_color }}"><a class="skip-link" href="#main">Pular para o conteúdo</a>{% sections 'header-group' %}<main id="main">{{ content_for_layout }}</main>{% sections 'footer-group' %}{% render 'age-gate' %}</body></html>