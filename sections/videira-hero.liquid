<section class="ve-hero">
{% if section.settings.image %}{{ section.settings.image | image_url: width: 2200 | image_tag: fetchpriority: 'high', loading: 'eager', sizes: '100vw', widths: '600,1000,1600,2200' }}{% else %}<img src="{{ 'videira-hero.jpg' | asset_url }}" alt="{{ 'home.hero_alt' | t }}" width="1600" height="1067" fetchpriority="high">{% endif %}
<div class="ve-hero-shade"></div><div class="ve-hero-content"><p class="ve-kicker">{{ 'home.location' | t }}</p><h1>{{ 'home.hero_one' | t }}<br>{{ 'home.hero_two' | t }}<br><span>{{ 'home.hero_three' | t }}</span></h1><div class="ve-hero-bottom"><p>{{ 'home.hero_intro' | t }}</p><a class="ve-primary" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ 'general.explore_wines' | t }}{% render 'icon', name: 'arrow' %}</a></div></div><a class="ve-scroll" href="#selecao">{{ 'home.selection_link' | t }} <span>↓</span></a><span class="ve-hero-caption">{{ 'home.hero_caption' | t }}</span></section>
{% schema %}
{"name": "Videira · Banner", "settings": [{"type": "image_picker", "id": "image", "label": "Fotografia"}, {"type": "url", "id": "link", "label": "Destino do botão"}], "presets": [{"name": "Videira · Banner"}]}
{% endschema %}
