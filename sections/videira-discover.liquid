{% capture grape_links %}{% assign seen = '|' %}{% for product in collections.all.products %}{% assign grape = product.metafields.custom.grape.value %}{% assign key = grape | prepend: '|' | append: '|' %}{% if grape != blank %}{% unless seen contains key %}<a href="{{ routes.search_url }}?type=product&amp;q={{ grape | url_encode }}">{{ grape | escape }}{% render 'icon', name: 'arrow' %}</a>{% assign seen = seen | append: grape | append: '|' %}{% endunless %}{% endif %}{% endfor %}{% endcapture %}
{% assign grape_links = grape_links | strip %}
{% capture vendor_links %}{% for vendor in shop.vendors limit: 6 %}{% if vendor != blank %}<a href="{{ vendor | url_for_vendor }}">{{ vendor | escape }}{% render 'icon', name: 'arrow' %}</a>{% endif %}{% endfor %}{% endcapture %}
{% assign vendor_links = vendor_links | strip %}
{% if grape_links != blank or vendor_links != blank %}
<section class="ve-discover"><div><p class="ve-kicker">{{ 'home.discover_eyebrow' | t }}</p><h2>{{ 'home.discover_title' | t }}</h2></div><div class="ve-discover-lists{% if grape_links == blank or vendor_links == blank %} ve-discover-lists--single{% endif %}">
{% if grape_links != blank %}<section id="uvas"><h3>{{ 'home.by_grape' | t }}</h3>{{ grape_links }}<a class="ve-discover-all" href="{{ routes.all_products_collection_url }}">{{ 'general.all_wines' | t }}{% render 'icon', name: 'arrow' %}</a></section>{% endif %}
{% if vendor_links != blank %}<section id="bodegas"><h3>{{ 'home.by_producer' | t }}</h3>{{ vendor_links }}<a class="ve-discover-all" href="{{ routes.all_products_collection_url }}">{{ 'general.all_wines' | t }}{% render 'icon', name: 'arrow' %}</a></section>{% endif %}
</div></section>{% endif %}
{% schema %}
{"name": "Videira · Descobertas", "settings": [], "presets": [{"name": "Videira · Descobertas"}]}
{% endschema %}
