<section class="ve-discover"><div><p class="ve-kicker">{{ 'home.discover_eyebrow' | t }}</p><h2>{{ 'home.discover_title' | t }}</h2></div><div class="ve-discover-lists"><section id="uvas"><h3>{{ 'home.by_grape' | t }}</h3>{% assign seen = '|' %}{% for product in collections.all.products %}{% assign grape = product.metafields.custom.grape.value %}{% assign key = grape | prepend: '|' | append: '|' %}{% if grape != blank %}{% unless seen contains key %}<a href="{{ routes.search_url }}?type=product&amp;q={{ grape | url_encode }}">{{ grape | escape }}{% render 'icon', name: 'arrow' %}</a>{% assign seen = seen | append: grape | append: '|' %}{% endunless %}{% endif %}{% endfor %}<a class="ve-discover-all" href="{{ routes.all_products_collection_url }}">{{ 'general.all_wines' | t }} ↗</a></section><section id="bodegas"><h3>{{ 'home.by_producer' | t }}</h3>{% for vendor in shop.vendors limit: 6 %}<a href="{{ vendor | url_for_vendor }}">{{ vendor | escape }}{% render 'icon', name: 'arrow' %}</a>{% endfor %}<a class="ve-discover-all" href="{{ routes.all_products_collection_url }}">{{ 'general.all_wines' | t }} ↗</a></section></div></section>
{% schema %}
{"name": "Videira · Descobertas", "settings": [], "presets": [{"name": "Videira · Descobertas"}]}
{% endschema %}
