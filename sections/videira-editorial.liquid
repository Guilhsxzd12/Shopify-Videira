<section id="sobre" class="ve-about"><p class="ve-kicker">{{ 'home.about_eyebrow' | t }}</p><h2>{{ 'home.about_one' | t }}<br>{{ 'home.about_two' | t }}<br><span>{{ 'home.about_three' | t }}</span></h2><div><p>{{ 'home.about_intro' | t }}</p><p>{{ 'home.about_checkout' | t }}</p><a class="ve-primary" href="{{ routes.all_products_collection_url }}">{{ 'general.explore_wines' | t }}{% render 'icon', name: 'arrow' %}</a></div></section>
<section id="faq" class="ve-faq"><div><p class="ve-kicker">{{ 'home.faq_eyebrow' | t }}</p><h2>{{ 'home.help_title' | t }}</h2></div><div>{% for i in (1..3) %}{% assign question = 'home.question_' | append: i %}{% assign answer = 'home.answer_' | append: i %}<details><summary>{{ question | t }}</summary><p>{{ answer | t }}</p></details>{% endfor %}</div></section>
{% schema %}
{"name": "Videira · Sobre e dúvidas", "settings": [], "presets": [{"name": "Videira · Sobre e dúvidas"}]}
{% endschema %}
