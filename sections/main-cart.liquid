<section class="cart-page"><p class="kicker">SUA SELEÇÃO</p><h1>Seu carrinho</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-lines">{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy' }}{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.final_price | money }}</p></div><label>Quantidade <input type="number" min="0" name="updates[]" value="{{ item.quantity }}"></label><strong>{{ item.final_line_price | money }}</strong><a href="{{ item.url_to_remove }}">Remover</a></div>{% endfor %}</div><div class="cart-bottom"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p>Frete calculado posteriormente.</p><button type="submit" name="update" class="underlined">Atualizar carrinho</button><button type="submit" name="checkout" class="btn">Finalizar compra</button>{% if settings.whatsapp_checkout and settings.whatsapp != blank %}<a data-whatsapp-cart data-phone="{{ settings.whatsapp | escape }}" data-items="{% for item in cart.items %}{{ item.quantity }}x {{ item.product.title | escape }} ({{ item.final_line_price | money | escape }}){% unless forloop.last %} | {% endunless %}{% endfor %}" data-total="{{ cart.total_price | money | escape }}" class="underlined" href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener">Solicitar orçamento pelo WhatsApp ↗</a>{% endif %}</div></form>{% else %}<p>Seu carrinho está vazio.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Explorar os vinhos</a>{% endif %}</section>{% schema %}{"name":"Carrinho Videira","settings":[]} {% endschema %}