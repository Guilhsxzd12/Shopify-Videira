<section class="sf-catalog"><div class="sf-catalog-heading"><h1>{{ 'general.search' | t }}</h1></div><form class="sf-catalog-search" action="{{ routes.search_url }}" method="get">{% render 'icon', name: 'search' %}<input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'catalog.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}"><input type="hidden" name="type" value="product"><button type="submit" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'arrow' %}</button></form>{% if search.performed %}<p>{{ 'catalog.count' | t: count: search.results_count }}</p>{% paginate search.results by 24 %}<div class="sf-catalog-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% endif %}{% else %}<p>{{ 'catalog.empty' | t }}</p>{% endfor %}</div><nav class="sf-pagination" aria-label="{{ 'catalog.pages' | t }}">{{ paginate | default_pagination }}</nav>{% endpaginate %}{% endif %}</section>
{% schema %}
{"name": "Busca Videira", "settings": []}
{% endschema %}
