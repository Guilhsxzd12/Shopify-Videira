<section class="catalog-page"><p class="kicker">DESCUBRA SEU PRÓXIMO VINHO</p><h1>Pesquisar</h1><form class="search-form" action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Busque rótulos, uvas, bodegas..."><input type="hidden" name="type" value="product"><button class="btn">Buscar</button></form>{% if search.performed %}<p>{{ search.results_count }} resultados para “{{ search.terms | escape }}”</p><div class="catalog-grid">{% paginate search.results by 24 %}{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% endif %}{% endfor %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endpaginate %}</div>{% endif %}</section>{% schema %}{"name":"Busca Videira","settings":[]} {% endschema %}