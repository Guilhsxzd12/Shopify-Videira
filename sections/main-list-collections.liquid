<section class="catalog-page"><p class="kicker">EXPLORE A NOSSA ADEGA</p><h1>Coleções</h1><div class="catalog-grid">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<article class="wine-card"><a class="wine-photo" href="{{ collection.url }}">{% if collection.image %}{{ collection.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}<span>Explore os vinhos</span>{% endif %}</a><div class="wine-info"><h3><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h3><a class="card-link" href="{{ collection.url }}">Ver coleção ↗</a></div></article>{% endunless %}{% endfor %}</div></section>{% schema %}{"name":"Coleções Videira","settings":[]} {% endschema %}