<section id="paises" class="ve-origins"><div class="ve-origins-heading"><p class="ve-kicker">{{ 'home.origins_eyebrow' | t }}</p><h2>{{ 'home.world_one' | t }}<br>{{ 'home.world_two' | t }}<br><span>{{ 'home.world_three' | t }}</span></h2><p>{{ 'home.origins_intro' | t }}</p></div><div class="ve-origin-list">
{% if section.blocks.size > 0 %}{% for block in section.blocks %}<a href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span class="ve-index">{{ forloop.index | prepend: '0' }}</span><div><h3>{{ block.settings.title | default: block.settings.collection.title | escape }}</h3><p>{{ block.settings.subtitle | escape }}</p></div>{% render 'icon', name: 'arrow' %}</a>{% endfor %}{% else %}{% assign seen = '|' %}{% for product in collections.all.products %}{% assign country = product.metafields.custom.country.value %}{% assign key = country | prepend: '|' | append: '|' %}{% if country != blank %}{% unless seen contains key %}<a href="{{ routes.search_url }}?type=product&amp;q={{ country | url_encode }}"><div><h3>{{ country | escape }}</h3></div>{% render 'icon', name: 'arrow' %}</a>{% assign seen = seen | append: country | append: '|' %}{% endunless %}{% endif %}{% endfor %}{% endif %}
<a class="ve-origin-all" href="{{ routes.all_products_collection_url }}">{{ 'home.all_origins' | t }}{% render 'icon', name: 'arrow' %}</a></div></section>
{% schema %}
{"name": "Videira · Origens", "settings": [], "blocks": [{"type": "origin", "name": "Origem", "settings": [{"type": "collection", "id": "collection", "label": "Coleção"}, {"type": "text", "id": "title", "label": "País"}, {"type": "text", "id": "subtitle", "label": "Regiões"}]}], "presets": [{"name": "Videira · Origens"}]}
{% endschema %}
