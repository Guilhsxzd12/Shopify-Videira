{% assign source = section.settings.collection | default: collections.all %}
{% if source.products_count > 0 %}<section id="selecao" class="ve-selection"><div class="ve-selection-intro"><p class="ve-kicker">{{ 'home.selection_eyebrow' | t }}</p><h2>{{ 'home.selection_title' | t }} <span>{{ 'home.selection_accent' | t }}</span></h2><p>{{ 'home.selection_intro' | t }}</p><a class="ve-text-link" href="{{ routes.all_products_collection_url }}">{{ 'home.full_catalog' | t }}{% render 'icon', name: 'arrow' %}</a></div><div class="ve-selection-products">{% assign title = 'home.curated' | t %}{% assign eyebrow = 'home.each_label' | t %}{% render 'carousel', collection: source, title: title, eyebrow: eyebrow, limit: section.settings.limit %}</div></section>{% endif %}
{% schema %}
{"name": "Videira · Seleção", "settings": [{"type": "collection", "id": "collection", "label": "Coleção"}, {"type": "range", "id": "limit", "label": "Rótulos", "min": 2, "max": 12, "default": 6}], "presets": [{"name": "Videira · Seleção"}]}
{% endschema %}
