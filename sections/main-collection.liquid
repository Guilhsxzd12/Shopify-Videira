<section class="catalog-page"><div class="catalog-heading"><p class="kicker">EXPLORE A NOSSA ADEGA</p><h1>{{ collection.title | default: 'Todos os vinhos' | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</div><div class="catalog-toolbar"><span>{{ collection.products_count }} rótulos</span><form action="{{ collection.url }}" method="get"><label for="sort-by">Ordenar por</label><select id="sort-by" name="sort_by" onchange="this.form.submit()">{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if collection.sort_by == option.value %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></form></div><div class="catalog-layout">{% if collection.filters.size > 0 %}<aside class="catalog-filters"><form method="get" action="{{ collection.url }}">{% for filter in collection.filters %}<details open><summary>{{ filter.label | escape }}</summary>{% case filter.type %}{% when 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}>{{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>De <input name="{{ filter.min_value.param_name }}" type="number" value="{{ filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}"></label><label>Até <input name="{{ filter.max_value.param_name }}" type="number" value="{{ filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}"></label>{% endcase %}</details>{% endfor %}<button class="btn" type="submit">Aplicar filtros</button><a href="{{ collection.url }}">Limpar filtros</a></form></aside>{% endif %}<div class="catalog-grid">{% paginate collection.products by 24 %}{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>Nenhum vinho encontrado nesta seleção.</p>{% endfor %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endpaginate %}</div></div></section>{% schema %}{"name":"Catálogo Videira","settings":[]} {% endschema %}