<section class="sf-catalog"><div class="sf-catalog-heading"><div class="sf-breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span>{{ 'general.store' | t }}</div><h1>{% if collection.handle == 'all' %}{{ 'general.wine_store' | t }}{% else %}{{ collection.title | escape }}{% endif %}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</div>
<form class="sf-catalog-search" action="{{ routes.search_url }}" method="get">{% render 'icon', name: 'search' %}<input type="search" name="q" aria-label="{{ 'general.search' | t }}" placeholder="{{ 'catalog.search_placeholder' | t }}"><input type="hidden" name="type" value="product"><button type="submit" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'arrow' %}</button></form>
{% if collection.filters.size > 0 %}{% render 'filters', collection: collection %}{% endif %}
<div class="sf-results"><div class="sf-result-toolbar"><span>{{ 'catalog.count' | t: count: collection.products_count }}</span>{% if collection.filters.size > 0 %}<button class="sf-filter-toggle" type="button" data-filter-open aria-haspopup="dialog">{% render 'icon', name: 'menu' %}{{ 'catalog.filter' | t }}</button>{% endif %}
<form method="get" action="{{ collection.url }}">{% for filter in collection.filters %}{% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100.0 }}">{% endif %}{% if filter.max_value.value %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100.0 }}">{% endif %}{% endif %}{% endfor %}<label for="sort-by">{{ 'catalog.sort' | t }}</label><select id="sort-by" name="sort_by" data-auto-submit>{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if current_sort == option.value %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button class="sort-submit" type="submit">{{ 'catalog.apply' | t }}</button></form></div>
<div class="sf-active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value or filter.max_value.value %}<a href="{{ filter.url_to_remove }}">{{ filter.label | escape }} ×</a>{% endif %}{% endif %}{% endfor %}</div>
{% paginate collection.products by 24 %}<div class="sf-catalog-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>{{ 'catalog.empty' | t }}</p>{% endfor %}</div><nav class="sf-pagination" aria-label="{{ 'catalog.pages' | t }}">{{ paginate | default_pagination }}</nav>{% endpaginate %}</div></section>
{% schema %}
{"name": "Catálogo Videira", "settings": []}
{% endschema %}
