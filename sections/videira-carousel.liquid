{% assign source = section.settings.collection | default: collections.all %}{% if source.products_count > 1 %}{% render 'carousel', collection: source, title: section.settings.title, eyebrow: section.settings.eyebrow, limit: section.settings.limit, newest: section.settings.newest %}{% endif %}
