<div class="announcement">VIDEIRA VINHOTECA · FOZ DO IGUAÇU <span>Vinhos com origem e personalidade</span></div>
<header class="site-header"><div class="header-inner">
<a class="brand" href="{{ routes.root_url }}" aria-label="Videira Vinhoteca — Início">
{% if settings.brand_logo != blank %}{{ settings.brand_logo | image_url: width: 400 | image_tag: alt: 'Videira Vinhoteca', class: 'brand-image' }}{% else %}<img src="{{ 'videira-logo.svg' | asset_url }}" alt="" class="brand-leaf" width="49" height="49"><span class="brand-words"><strong>Videira</strong><small>VINHOTECA</small></span>{% endif %}
</a>
<nav class="desktop-nav" aria-label="Navegação principal"><a href="{{ routes.root_url }}">Início</a><a href="{{ routes.all_products_collection_url }}">Loja</a>
{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}{% if link.links != blank %}<details class="nav-dropdown"><summary>{{ link.title | escape }} <span>⌄</span></summary><div class="dropdown-panel">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }} <span>↗</span></a>{% endfor %}</div></details>{% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}{% endfor %}
{% else %}<a href="{{ routes.all_products_collection_url }}">Vinhos</a><a href="{{ routes.all_products_collection_url }}">Países</a><a href="{{ routes.all_products_collection_url }}">Uvas</a><a href="{{ routes.all_products_collection_url }}">Bodegas</a><a href="/pages/a-videira">A Videira</a>{% endif %}</nav>
<div class="header-actions"><a href="{{ routes.search_url }}" aria-label="Pesquisar"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.7" cy="10.7" r="6.3"/><path d="m15.5 15.5 5 5"/></svg></a><a href="{{ routes.cart_url }}" aria-label="Carrinho"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>{% if cart.item_count > 0 %}<sup>{{ cart.item_count }}</sup>{% endif %}</a><button type="button" class="mobile-toggle" aria-label="Abrir menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle>☰</button></div>
</div><nav id="mobile-menu" class="mobile-nav" hidden aria-label="Menu mobile"><a href="{{ routes.root_url }}">Início</a><a href="{{ routes.all_products_collection_url }}">Loja</a>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% for sub in link.links %}<a class="mobile-sub" href="{{ sub.url }}">{{ sub.title | escape }}</a>{% endfor %}{% endfor %}</nav></header>
{% schema %}{"name":"Cabeçalho Videira","settings":[{"type":"link_list","id":"menu","label":"Menu principal"}]}{% endschema %}