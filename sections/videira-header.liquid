<div class="announcement">VIDEIRA VINHOTECA · FOZ DO IGUAÇU <span>Vinhos com origem e personalidade</span></div><header class="site-header"><div class="header-inner"><a class="brand" href="{{ routes.root_url }}">{% if settings.brand_logo %}{{ settings.brand_logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'brand-image' }}{% else %}<strong>VIDEIRA</strong><small>VINHOTECA</small>{% endif %}</a><nav class="desktop-nav" aria-label="Navegação principal"><a href="{{ routes.root_url }}">Início</a><a href="{{ routes.all_products_collection_url }}">Loja</a>{% for link in section.settings.menu.links %}{% if link.links != blank %}<details class="nav-dropdown"><summary>{{ link.title | escape }} <span>⌄</span></summary><div class="dropdown-panel">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }} <span>↗</span></a>{% endfor %}</div></details>{% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}{% endfor %}</nav><div class="header-actions"><a href="{{ routes.search_url }}" aria-label="Pesquisar">⌕</a><a href="{{ routes.cart_url }}" aria-label="Carrinho">▢<sup>{{ cart.item_count }}</sup></a><button class="mobile-toggle" aria-label="Abrir menu" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle>☰</button></div></div><nav id="mobile-menu" class="mobile-nav" hidden aria-label="Menu mobile"><a href="{{ routes.root_url }}">Início</a><a href="{{ routes.all_products_collection_url }}">Todos os vinhos</a>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% for sub in link.links %}<a class="mobile-sub" href="{{ sub.url }}">{{ sub.title | escape }}</a>{% endfor %}{% endfor %}</nav></header>{% schema %}{"name":"Cabeçalho Videira","settings":[{"type":"link_list","id":"menu","label":"Menu principal"}]}{% endschema %}