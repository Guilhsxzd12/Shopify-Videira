<section class="product-page"><nav class="breadcrumbs"><a href="/">Início</a> / <a href="{{ routes.all_products_collection_url }}">Loja</a> / {{ product.title | escape }}</nav><div class="product-layout"><div class="product-gallery">{% for media in product.media %}{% if media.media_type == 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}{% else %}<div class="image-empty">Fotografia em breve</div>{% endfor %}</div><div class="product-detail"><p class="kicker">{{ product.vendor | escape }}{% if product.metafields.custom.country.value %} · {{ product.metafields.custom.country.value | escape }}{% endif %}</p><h1>{{ product.title | escape }}</h1><p class="product-type">{{ product.type | escape }}{% if product.metafields.custom.grape.value %} · {{ product.metafields.custom.grape.value | escape }}{% endif %}</p><div class="product-price"><small>Preço</small><strong id="product-current-price">{{ product.selected_or_first_available_variant.price | money }}</strong></div>{% form 'product', product, id: 'videira-product-form' %}{% unless product.has_only_default_variant %}<label for="variant-select">Variante</label><select id="variant-select" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="quantity">Quantidade</label><input id="quantity" name="quantity" type="number" min="1" value="1"><button class="btn" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Adicionar ao carrinho{% else %}Indisponível{% endif %}</button>{% endform %}<p class="small-note">Entrega calculada no checkout conforme o CEP e as opções disponíveis.</p><div class="product-accordion"><details open><summary>Sobre este vinho</summary><div class="rte">{{ product.description }}</div></details><details><summary>Ficha técnica</summary><dl>{% if product.vendor != blank %}<dt>Vinícola / bodega</dt><dd>{{ product.vendor | escape }}</dd>{% endif %}{% for field in product.metafields.custom %}<dt>{{ field[0] | replace: '_', ' ' | capitalize }}</dt><dd>{{ field[1].value | escape }}</dd>{% endfor %}</dl></details></div></div></div></section>{% schema %}{"name":"Produto Videira","settings":[]} {% endschema %}