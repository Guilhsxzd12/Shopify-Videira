{% assign variant = product.selected_or_first_available_variant %}
<section class="sf-section pd-product"><nav class="pd-breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><a href="{{ routes.all_products_collection_url }}">{{ 'general.store' | t }}</a><span>/</span><span aria-current="page">{{ product.title | escape }}</span></nav>
<div class="pd-grid"><div class="pd-gallery"><button class="pd-photo-button" type="button" data-product-zoom {% unless product.featured_image %}disabled{% endunless %} aria-label="{{ 'product.zoom' | t }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: class: 'pd-original-photo', fetchpriority: 'high', widths: '400,700,1000,1400', sizes: '(max-width: 760px) 90vw, 45vw', alt: product.title }}<span class="pd-zoom-hint">{{ 'product.zoom' | t }} +</span>{% else %}<span class="pd-photo-missing">{% render 'icon', name: 'glass' %}{{ 'product.no_image' | t }}</span>{% endif %}</button>
{% if product.images.size > 1 %}<div class="pd-thumbnails">{% for image in product.images %}<button type="button" data-product-image="{{ image | image_url: width: 1400 }}" aria-label="{{ image.alt | default: product.title | escape }}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: image.alt }}</button>{% endfor %}</div>{% endif %}</div>
<div class="pd-summary"><p class="pd-origin">{{ product.metafields.custom.country.value | escape }}{% if product.metafields.custom.region.value %} · {{ product.metafields.custom.region.value | escape }}{% endif %}</p><h1>{{ product.title | escape }}</h1><a class="pd-winery" href="{{ product.vendor | url_for_vendor }}">{{ product.vendor | escape }}</a><p class="pd-style">{{ product.type | escape }}{% if product.metafields.custom.grape.value %} · {{ product.metafields.custom.grape.value | escape }}{% endif %}</p>
<div class="pd-price"><span>{{ 'product.price' | t }}</span><del data-product-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</del><strong data-product-price>{{ variant.price | money }}</strong><p>{{ 'product.delivery' | t }}</p></div>
{% form 'product', product, id: 'videira-product-form', data-shopify-add: '' %}{{ form.errors | default_errors }}
{% unless product.has_only_default_variant %}<label class="pd-variant-label" for="variant-select">{{ 'product.variant' | t }}</label><select class="pd-variant" id="variant-select" name="id">{% for option in product.variants %}<option value="{{ option.id }}" {% if option.id == variant.id %}selected{% endif %}>{{ option.title | escape }}{% unless option.available %} — {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ variant.id }}">{% endunless %}
<div class="pd-purchase"><label for="product-quantity">{{ 'product.quantity' | t }}<input id="product-quantity" name="quantity" type="number" min="{{ variant.quantity_rule.min | default: 1 }}" step="{{ variant.quantity_rule.increment | default: 1 }}" {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %} value="{{ variant.quantity_rule.min | default: 1 }}"></label><button class="sf-button" type="submit" data-product-submit {% unless variant.available %}disabled{% endunless %}>{% render 'icon', name: 'bag' %}<span data-product-button-label>{% if variant.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span></button></div><p class="pd-added" data-add-status role="status"></p>{% endform %}
<script type="application/json" data-product-variants>[{% for v in product.variants %}{"id":{{ v.id | json }},"available":{{ v.available | json }},"price":{{ v.price | money | json }},"compare":{{ v.compare_at_price | money | json }},"on_sale":{% if v.compare_at_price > v.price %}true{% else %}false{% endif %},"image":{% if v.featured_image %}{{ v.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %},"min":{{ v.quantity_rule.min | default: 1 }},"step":{{ v.quantity_rule.increment | default: 1 }},"max":{{ v.quantity_rule.max | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script></div></div>
<div class="pd-information pd-compact-information">{% if product.description != blank %}<details class="pd-detail-panel" open><summary>{{ 'product.about' | t }}</summary><div class="rte">{{ product.description }}</div></details>{% endif %}
<details class="pd-detail-panel"><summary>{{ 'product.specifications' | t }}</summary><dl class="pd-specs"><div><dt>{{ 'general.producers' | t }}</dt><dd>{{ product.vendor | escape }}</dd></div><div><dt>{{ 'product.type' | t }}</dt><dd>{{ product.type | escape }}</dd></div>{% assign fields = 'country,region,grape,vintage,volume,alcohol,aging,serving_temperature' | split: ',' %}{% for key in fields %}{% assign field = product.metafields.custom[key] %}{% if field != blank %}{% assign label = 'spec.' | append: key %}<div><dt>{{ label | t }}</dt><dd>{{ field | metafield_text | escape }}</dd></div>{% endif %}{% endfor %}</dl></details>
{% assign sensory_fields = 'visual,aromas,palate,tasting_notes,pairing' | split: ',' %}{% for key in sensory_fields %}{% assign field = product.metafields.custom[key] %}{% if field != blank %}{% assign label = 'spec.' | append: key %}<details class="pd-detail-panel"><summary>{{ label | t }}</summary><p>{{ field | metafield_text | escape }}</p></details>{% endif %}{% endfor %}</div>
{% if product.featured_image %}<dialog class="pd-zoom" data-zoom-dialog aria-label="{{ 'product.zoom' | t }}"><button class="pd-zoom-close" type="button" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>{{ product.featured_image | image_url: width: 1800 | image_tag: class: 'pd-original-photo', loading: 'lazy', alt: product.title }}</dialog>{% endif %}
<script type="application/ld+json">{{ product | structured_data }}</script></section>
{% assign source = collection | default: collections.all %}{% capture related_cards %}{% assign shown = 0 %}{% for related in source.products %}{% unless related.id == product.id %}{% render 'product-card', product: related %}{% assign shown = shown | plus: 1 %}{% if shown == 8 %}{% break %}{% endif %}{% endunless %}{% endfor %}{% endcapture %}{% assign related_cards = related_cards | strip %}{% if related_cards != blank %}<section class="wc-section"><div class="wc-heading"><h2>{{ 'product.related' | t }}</h2></div><div class="wc-viewport"><div class="wc-track"><div class="wc-group">{{ related_cards }}</div></div></div></section>{% endif %}
{% schema %}
{"name": "Produto Videira", "settings": []}
{% endschema %}
